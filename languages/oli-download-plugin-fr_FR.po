msgid "Security check failed."
msgstr "Échec de la vérification de sécurité."

msgid "Invalid download type."
msgstr "Type de téléchargement invalide."

msgid "You do not have permission to download plugins."
msgstr "Vous n’avez pas la permission de télécharger des extensions."

msgid "Invalid plugin."
msgstr "Extension invalide."

msgid "Plugin files not found."
msgstr "Fichiers de l’extension introuvables."

msgid "You do not have permission to download themes."
msgstr "Vous n’avez pas la permission de télécharger des thèmes."

msgid "Invalid theme."
msgstr "Thème invalide."

msgid "Theme files not found."
msgstr "Fichiers du thème introuvables."

msgid "You do not have permission to download must-use plugins."
msgstr "Vous n’avez pas la permission de télécharger les extensions indispensables."

msgid "Invalid must-use plugin."
msgstr "Extension indispensable invalide."

msgid "Must-use plugin files not found."
msgstr "Fichiers de l’extension indispensable introuvables."

msgid "You do not have permission to download drop-ins."
msgstr "Vous n’avez pas la permission de télécharger les fichiers drop-in."

msgid "Invalid drop-in."
msgstr "Fichier drop-in invalide."

msgid "Drop-in file not found."
msgstr "Fichier drop-in introuvable."

msgid "No valid plugins to download."
msgstr "Aucune extension valide à télécharger."

msgid "Failed to create a temporary ZIP file."
msgstr "Échec de la création d’un fichier ZIP temporaire."

msgid "Failed to finalize the ZIP archive."
msgstr "Échec de la finalisation de l’archive ZIP."

msgid "Failed to create ZIP file."
msgstr "Échec de la création du fichier ZIP."

msgid "ZIP file not found."
msgstr "Fichier ZIP introuvable."

msgid "Download"
msgstr "Télécharger"

msgid "Oli Download Plugin"
msgstr "Oli Download Plugin"

msgid "You do not have permission to change these settings."
msgstr "Vous n’avez pas la permission de modifier ces réglages."

msgid "You do not have permission to access this page."
msgstr "Vous n’avez pas la permission d’accéder à cette page."

msgid "Settings saved."
msgstr "Réglages enregistrés."

msgid "Download installed plugins and themes as ZIP files from the Plugins and Themes screens. Administrators can also download users, posts, pages, comments, and terms as CSV."
msgstr "Téléchargez les extensions et thèmes installés en fichiers ZIP depuis les écrans Extensions et Thèmes. Les administrateurs peuvent aussi télécharger les utilisateurs, articles, pages, commentaires et termes en CSV."

msgid "Select at least one plugin to download."
msgstr "Sélectionnez au moins une extension à télécharger."

msgid "Upload Multiple Plugins"
msgstr "Téléverser plusieurs extensions"

msgid "Custom ZIP exclusions"
msgstr "Exclusions ZIP personnalisées"

msgid "One pattern per line (for example vendor or *.bak). Added to the default exclusions and the oli_dlp_excluded_patterns filter."
msgstr "Un motif par ligne (par exemple vendor ou *.bak). Ajouté aux exclusions par défaut et au filtre oli_dlp_excluded_patterns."

msgid "Install several plugin ZIP files in one go. Only valid WordPress plugin archives are accepted."
msgstr "Installez plusieurs archives ZIP d’extensions en une seule fois. Seules les archives d’extensions WordPress valides sont acceptées."

msgid "Must-use plugins"
msgstr "Extensions indispensables"

msgid "Allow download of must-use plugins (mu-plugins)."
msgstr "Autoriser le téléchargement des extensions indispensables (mu-plugins)."

msgid "Drop-ins"
msgstr "Drop-ins"

msgid "Allow download of WordPress drop-in files (object-cache.php, advanced-cache.php, and others)."
msgstr "Autoriser le téléchargement des fichiers drop-in WordPress (object-cache.php, advanced-cache.php et autres)."

msgid "Save settings"
msgstr "Enregistrer les réglages"

msgid "None found."
msgstr "Aucun élément trouvé."

msgid "Name"
msgstr "Nom"

msgid "GitHub"
msgstr "GitHub"

msgid "%d plugin(s) installed."
msgstr "%d extension(s) installée(s)."

msgid "Some archives could not be installed. Use a valid WordPress plugin ZIP."
msgstr "Certaines archives n’ont pas pu être installées. Utilisez un ZIP d’extension WordPress valide."

msgid "Plugin ZIP files"
msgstr "Fichiers ZIP d’extensions"

msgid "Install plugins"
msgstr "Installer les extensions"

msgid "You do not have permission to install plugins."
msgstr "Vous n’avez pas la permission d’installer des extensions."

msgid "You do not have permission to export this data."
msgstr "Vous n’avez pas la permission d’exporter ces données."

msgid "Failed to create CSV file."
msgstr "Échec de la création du fichier CSV."

msgid "%d plugin(s) activated."
msgstr "%d extension(s) activée(s)."

msgid "Some plugins could not be activated."
msgstr "Certaines extensions n’ont pas pu être activées."

msgid "You do not have permission to activate plugins."
msgstr "Vous n’avez pas la permission d’activer des extensions."

msgid "Activate the plugins you just installed."
msgstr "Activez les extensions que vous venez d’installer."

msgid "Activate all"
msgstr "Tout activer"
