msgid "Security check failed."
msgstr "Échec de la vérification de sécurité."

msgid "Invalid download type."
msgstr "Type de téléchargement invalide."

msgid "You do not have permission to download plugins."
msgstr "Vous n’avez pas la permission de télécharger des extensions."

msgid "Invalid plugin."
msgstr "Extension invalide."

msgid "Plugin files not found."
msgstr "Fichiers de l’extension introuvables."

msgid "You do not have permission to download themes."
msgstr "Vous n’avez pas la permission de télécharger des thèmes."

msgid "Invalid theme."
msgstr "Thème invalide."

msgid "Theme files not found."
msgstr "Fichiers du thème introuvables."

msgid "You do not have permission to download must-use plugins."
msgstr "Vous n’avez pas la permission de télécharger les extensions indispensables."

msgid "Invalid must-use plugin."
msgstr "Extension indispensable invalide."

msgid "Must-use plugin files not found."
msgstr "Fichiers de l’extension indispensable introuvables."

msgid "You do not have permission to download drop-ins."
msgstr "Vous n’avez pas la permission de télécharger les fichiers drop-in."

msgid "Invalid drop-in."
msgstr "Fichier drop-in invalide."

msgid "Drop-in file not found."
msgstr "Fichier drop-in introuvable."

msgid "No valid plugins to download."
msgstr "Aucune extension valide à télécharger."

msgid "Failed to create a temporary ZIP file."
msgstr "Échec de la création d’un fichier ZIP temporaire."

msgid "Failed to finalize the ZIP archive."
msgstr "Échec de la finalisation de l’archive ZIP."

msgid "Failed to create ZIP file."
msgstr "Échec de la création du fichier ZIP."

msgid "ZIP file not found."
msgstr "Fichier ZIP introuvable."

msgid "Download"
msgstr "Télécharger"

msgid "Oli Download Plugin"
msgstr "Oli Download Plugin"

msgid "You do not have permission to change these settings."
msgstr "Vous n’avez pas la permission de modifier ces réglages."

msgid "You do not have permission to access this page."
msgstr "Vous n’avez pas la permission d’accéder à cette page."

msgid "Settings saved."
msgstr "Réglages enregistrés."

msgid "Download installed plugins and themes as ZIP files from the Plugins and Themes screens. Uploads and other wp-content data are never included."
msgstr "Téléchargez les extensions et thèmes installés en fichiers ZIP depuis les écrans Extensions et Thèmes. Le dossier uploads et les autres données de wp-content ne sont jamais inclus."

msgid "Must-use plugins"
msgstr "Extensions indispensables"

msgid "Allow download of must-use plugins (mu-plugins)."
msgstr "Autoriser le téléchargement des extensions indispensables (mu-plugins)."

msgid "Drop-ins"
msgstr "Drop-ins"

msgid "Allow download of WordPress drop-in files (object-cache.php, advanced-cache.php, and others)."
msgstr "Autoriser le téléchargement des fichiers drop-in WordPress (object-cache.php, advanced-cache.php et autres)."

msgid "Save settings"
msgstr "Enregistrer les réglages"

msgid "None found."
msgstr "Aucun élément trouvé."

msgid "Name"
msgstr "Nom"

msgid "GitHub"
msgstr "GitHub"
